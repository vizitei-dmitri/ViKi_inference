# Build the user's existing native wrapper and keep compilers out of runtime.
FROM viki-live-hand AS sdk-build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake libeigen3-dev && rm -rf /var/lib/apt/lists/*
COPY --from=dg5f_source vendor/tesollo_control /tmp/tesollo_control
RUN --mount=type=cache,target=/root/.cache/pip \
    pip wheel --no-deps /tmp/tesollo_control -w /wheels
RUN g++ -std=c++20 -pthread -I/usr/include/eigen3 \
    -I/tmp/tesollo_control/include -I/tmp/tesollo_control \
    /tmp/tesollo_control/dg_control/control.cpp \
    /tmp/tesollo_control/tests/fake_sdk_test.cpp -o /tmp/fake_sdk_test && \
    timeout 20s /tmp/fake_sdk_test
RUN python -c "import pathlib,json,hashlib; p=pathlib.Path('/tmp/tesollo_control'); pathlib.Path('/wheels/provenance.json').write_text(json.dumps({str(f.relative_to(p)):hashlib.sha256(f.read_bytes()).hexdigest() for f in p.rglob('*') if f.is_file()},sort_keys=True,indent=2))"

FROM viki-live-hand
COPY --from=sdk-build /wheels /opt/dg5f-sdk
RUN pip install --no-deps /opt/dg5f-sdk/*.whl && python -c "import dg5f_python"
